<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rounded Square Icons</title>
  <style>
    /* ===== Layout: Align icons side-by-side ===== */
    .icon-container {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 20px;
    }

    /* ===== Shape: Rounded square (iOS-style) ===== */
    .icon {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .icon svg {
      width: 32px;
      height: 32px;
    }

    /* ===== Individual icon styles ===== */
    .icon--light {
      background-color: #f0efe9;
      border: 1px solid #e0ddd5;
    }

    .icon--dark {
      background-color: #d9d5de;
      border: 1px solid #c9c4cf;
    }
  </style>
</head>
<body>
  <div class="icon-container">
    <!-- Light Icon (Sun/Brightness) -->
    <div class="icon icon--light">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#6b6b7b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <line x1="12" y1="2" x2="12" y2="5"></line>
        <line x1="12" y1="19" x2="12" y2="22"></line>
        <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
        <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
        <line x1="2" y1="12" x2="5" y2="12"></line>
        <line x1="19" y1="12" x2="22" y2="12"></line>
        <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
        <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
      </svg>
    </div>

    <!-- Dark Icon (Atom/Molecule) -->
    <div class="icon icon--dark">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#6b6b7b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="2" fill="#8b7b9b"></circle>
        <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(0 12 12)"></ellipse>
        <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(60 12 12)"></ellipse>
        <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(120 12 12)"></ellipse>
        <circle cx="19" cy="7" r="1.5" fill="#8b7b9b" stroke="none"></circle>
        <circle cx="5" cy="17" r="1.5" fill="#8b7b9b" stroke="none"></circle>
        <circle cx="17" cy="18" r="1.5" fill="#8b7b9b" stroke="none"></circle>
      </svg>
    </div>
  </div>
</body>
</html>
